# .env.example — Project DRISHTI Configuration
# Copy to .env and fill in real values before running.
# IMPORTANT: Never commit .env — it is listed in .gitignore.

# ── Security & Authentication ──────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
DRISHTI_SECRET_KEY=change-this-to-a-random-256-bit-secret-before-production
DRISHTI_DEMO_USERNAME=admin
DRISHTI_DEMO_PASSWORD=Drishti@2026
DRISHTI_DEMO_ROLE=admin
DRISHTI_DEMO_EMAIL=admin@drishti.local
SESSION_EXPIRY=30

# ── Admin API Key (for model retraining endpoint) ──────────
ADMIN_API_KEY=your-secure-key-here

# ── SQLite / PostgreSQL Database ───────────────────────────
DATABASE_URL=sqlite:///./data/drishti.db

# ── Service Hosts & Ports ───────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
DRISHTI_AUTO_OPEN_BROWSER=true
DRISHTI_ENV=development
DEBUG=true

# ── ML Model Paths ──────────────────────────────────────────
NLP_MODEL_PATH=models/hingbert
XGBOOST_MODEL_PATH=models/time_predictor.json
GRAPH_DATA_PATH=data/complaints.csv
