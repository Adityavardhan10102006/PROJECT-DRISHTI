        "atm_latitude",
        "atm_longitude",
        "victim_latitude",
        "victim_longitude",
        "bank_enc",
        "is_24x7",
        "local_density_1km",
        "dist_to_police_km",
        "fraud_type_enc",
        "amount",
        "log_amount",
        "complaint_hour",
        "day_of_week",
        "is_weekend",
        "is_night",
        "city_tier",
        "hop_count",
        "trail_duration_mins",
        "mule_count",
        "max_betweenness",
        "in_degree",
        "out_degree",
        "hist_atm_withdrawals",
        "hist_atm_cashout_sum",
        "hist_tod_match"
      ],
      "target": "is_actual_withdrawal_location (0 or 1)",
      "group_key": "complaint_id",
