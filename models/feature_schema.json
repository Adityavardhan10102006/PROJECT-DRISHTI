        "is_weekend",
        "city_tier",
        "est_withdrawal_mins"
      ],
      "target": "risk_tier (0: LOW, 1: MEDIUM, 2: HIGH, 3: CRITICAL)",
      "leakage_controls": [
        "Stratified holdout validation",
        "Calibrated probability scaling (Isotonic/Platt)"
      ]
    }
  }
}